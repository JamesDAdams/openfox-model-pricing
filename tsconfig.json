{
  "compilerOptions": {
    "target": "ESNext",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "verbatimModuleSyntax": true,
    "declaration": true,
    "noEmit": true,
    "allowJs": true,
    "checkJs": false,
    "paths": {
      "openfox/plugin": ["../../src/plugin/index.ts"],
      "openfox/*": ["../../src/*"]
    }
  },
  "include": ["src/**/*"]
}
